//Time Complexity:O(n lon n)
// Space Complexity:O(n)




#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
ll tree[200005];
ll n,q;
//Construction
void  update( ll index,  ll value){
           while(index<=n){
            tree[index]+=value;
            index+=(index & -index);
           }
}
//Prefix sum or Range sum
 ll read( ll   index){
          ll sum=0;
          while(index>0){
            sum+=tree[index];
            index-=(index & -index);
          }

   return sum;
   }

   ll range_sum(ll l,ll r){
       return  read(r)-read(l-1);
   }
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
   cin>>n>>q;
   vector<ll>arr(n+1);
   for(ll i=1;i<=n;i++){
        cin>>arr[i];
        update(i,arr[i]);
   }
   while(q--){
        ll  a,b,c;cin>>a>>b>>c;
        if(a==1){
            update(b,c-arr[b]);
            arr[b]=c;
        }
        else if(a==2){
           ll res= range_sum(b,c);
           cout<<res<<'\n';
        }


   }
return 0;
}
