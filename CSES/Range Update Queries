// Time Complexity:O(nlog n)
//Space Complexity:(n)


#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
ll n,q;
ll B1[200005];

void add_to(ll *arr, ll index, ll value){
        while(index<=n){
            arr[index]+=value;
            index+=(index & -index);
        }
}
void range_update(ll l , ll r, ll v){
        add_to(B1,l,v);
        add_to(B1,r+1,-v);
}

ll read(ll *arr, ll index){
      ll sum=0;
      while(index>0){
        sum+=arr[index];
        index-=(index & -index);
      }
   return sum;
}

ll point_query(ll x){
     return read(B1, x);

}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
   cin>>n>>q;
   vector<ll>arr(n+1);
   for(ll i=1;i<=n;i++){
        cin>>arr[i];
   }
   while(q--){
        ll  a;cin>>a;
        if(a==1){
            ll l,r,v;cin>>l>>r>>v;
            range_update(l,r,v);
        }
        else {
                ll  x;cin>>x;
             cout<<arr[x]+point_query(x)<<'\n';
        }


   }
return 0;
}
