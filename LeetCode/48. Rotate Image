//Both Methods
//Time Complexity:O(n^2)
//Space Complexity:O(1)

Method-01
class Solution {
public:
    void rotate(vector<vector<int>>& matrix) {
        int n=matrix.size();
        int offset=1000;
        for(auto &row:matrix){
            for(auto &x:row)x+=offset;
        }

        int mxElem=-1;
        for(auto &row:matrix){
            mxElem=max(mxElem,*max_element(begin(row),end(row)));
        }

        mxElem++;

        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                 matrix[i][j]+=(matrix[n-j-1][i]%mxElem)*mxElem;
            }
        }

        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                matrix[i][j]=(matrix[i][j]/mxElem)-offset;
            }
        }

        
    }
};


Method-02
class Solution {
public:
    void rotate(vector<vector<int>>& matrix) {
        int n=matrix.size();
        // at first convert to transpose matrix
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                swap(matrix[i][j],matrix[j][i]);
            }
        }
      // then, reverse each row
        for(auto &row:matrix){
            reverse(begin(row),end(row));
        }
    }
};
