//Time Complexity:O(n)
//Space Complexity:O(1)

class Solution {
public:
    int wateringPlants(vector<int>& plants, int capacity) {
          int n=plants.size();
          int cnt=0,cap=capacity;
          for(int i=0;i<n;i++){
            if(plants[i]<=cap){
                cnt++;
                cap-=plants[i];
            }
            else{
                 cap=capacity;
                 cnt+=i+1;
                 cnt+=i;
                 cap-=plants[i];
            }
          }


          return cnt;
    }
};
