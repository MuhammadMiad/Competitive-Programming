//Time Complexity:O(n)
//Space Complexity:O(n)

class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n=nums.size();
        stack<int>st;
        vector<int>ans(n,-1);

        for(int i=2*n-1;i>=0;i--){
            int x=nums[i%n];
            while(!st.empty() and st.top()<=x)st.pop();

            if(!st.empty())ans[i%n]=st.top();

            st.push(x);
        }


        return ans;
    }
};
