//Time Complexity:O(1) only 27 
//Space Complexity:O(1)

class Solution {
public:
    bool isValid(string &s,int index, int len){
    //check first digit weather zero
    if( len>1 and s[index]=='0')return 0;

    int value=0;
    for(int i=index;i<len+index;i++)value=value*10+(s[i]-'0');

    if(value<=255)return 1;

    return 0;
}

vector<string > restoreIpAddresses(string &s){

     int n=s.size();
     vector<string >res;
     if(n<4 || n>12)return res;

     for(int a=1;a<=3;a++){
        for(int b=1;b<=3;b++){
            for(int c=1;c<=3;c++){
                int d=n-a-b-c;
                if( d<1 || d>3)continue;
                if(isValid(s,0,a)  and  isValid(s,a,b)  and isValid(s,a+b,c) and isValid(s,a+b+c,d)){
                    res.push_back(s.substr(0,a)+"."+s.substr(a,b)+"."+s.substr(a+b,c)+"."+s.substr(a+b+c, d) );
                }
            }
        }
     }


     return res;
}
};
