//Method 02
//Time Complexity:O(n)
//Space Complexity:O(1)

class Solution {
public:
    int lengthOfLastWord(string& s) {
        int i = s.size() - 1;
        while (i >= 0 && s[i] == ' ') i--;     // last space remove

        int len = 0;
        while (i >= 0 && s[i] != ' ') {      //Just last word count
            len++;
            i--;
        }
        return len;
    }
};
