//TC:O(n^2)
//SC:O(1)

class Solution {
public:
    int threeSumClosest(vector<int>& nums, int target) {
        int n=nums.size();
        sort(begin(nums),end(nums));
        int mn=INT_MAX;
        int store;
        for(int i=0;i<n-2;i++){
            if(i>0 and nums[i-1]==nums[i])continue;

            int l=i+1,r=n-1;
            while(l<r){
                int sum=nums[i]+nums[l]+nums[r];
                if(sum>target){
                    if(mn>abs(sum-target)){
                        mn=abs(sum-target);
                        store=sum;
                    }
                    r--;
                }
                else{
                    if(mn>abs(sum-target)){
                        mn=abs(sum-target);
                        store=sum;
                    }
                    l++;
                }
            }
        }

        return store;
    }
};
