    // N-=d*count  181-=2*90 =11  -> d=3 count=900  start=100 

    //number=start+(N-1)/d  =100+(11-1)/3 =100+ 10/3 = 103

    //digit= (N-1)%d  = (11-1)%3  =1   -> 1-0d,0-1d,3-2d
    //return 0-1d
    


    }
};
