//TC:O(logn)
//SC:O(1)

class Solution {
public:
    int findNthDigit(int n) {
        
     long long d=1,count=9,start=1;
    
    //Find present whice group
     while(n>d*count){
           n-=d*count;
           count*=10;
           start*=10;
           d++;
     }

     //Find which number

    long long number=start+(n-1)/d;

    //Find which digit of number

    int digit=(n-1)%d;

    return to_string(number)[digit]-'0';

    //dry run 
    // N=200
