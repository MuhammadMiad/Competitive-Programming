//Time Complexity:O(n*maxdigit)
//Space Complexity:O(n)


class Solution {
public:
    string decodeString(string s) {
        stack<string>str;
        stack<int>num;
        string curstr="";
        int curNum=0;
        
        for(auto c:s){
            if(isdigit(c)){
                curNum=curNum*10+(c-'0');
            }
            else if(c=='['){
                num.push(curNum);
                curNum=0;
                str.push(curstr);
                curstr="";
            }
            else if(c==']'){
                string  prevstr=str.top();str.pop();
                int k=num.top();num.pop();
                
                string temp="";
                 while(k--){
                    temp+=curstr;
                 } 
                 curstr=prevstr+temp;

            }
            else curstr+=c;

        }
        return curstr;
        
    }
};
