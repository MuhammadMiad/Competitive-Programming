//Time Complexity:O(n)
//Space Complexity:O(n)


class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {
        int n=adj.size();
        queue<int>q;
        q.push(0);
        vector<int>visit(n,0);
        visit[0]=1;
        
        vector<int>ans;
        while(!q.empty()){
            int x=q.front();
            q.pop();
            
            ans.push_back(x);
            for(int i=0;i<adj[x].size();i++){
                if(!visit[adj[x][i]]){
                    visit[adj[x][i]]=1;
                    q.push(adj[x][i]);
                }
            }
        }
        
        
        return ans;
        
    }
};
