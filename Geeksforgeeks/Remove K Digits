//Time Complexity: O(n + k)
//Auxiliary Space: O(n)


class Solution {
  public:
    string removeKdig(string &s, int k) {
        
        string st;
        for(int i=0;i<s.size();i++){
           int cur=s[i];
           while(k>0 and !st.empty() and st.back()>cur){
               st.pop_back();
               k--;
           }
           
           st.push_back(cur);
        }
        
        //if k>0
        while(k>0){
            st.pop_back();
            k--;
        }
        
        // if leading zero
        int i=0;
        while(i<st.size() and st[i]=='0')i++;
        st=st.substr(i);
        
        return (st.empty() ? "0":st);
      
    }
};
