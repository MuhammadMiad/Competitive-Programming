//Time Complexity: O(n * log(max(arr)))
//Auxiliary Space: O(n)

class Solution {
  public:
   void countingSort(vector<int>&arr,int n, int pos){
       vector<int>count(10,0);
       vector<int>store(n,0);
       for(int i=0;i<n;i++){
           int rem=((arr[i]/pos)%10);
           count[rem]++;
       }
       
       for(int i=1;i<10;i++){
           count[i]=count[i-1]+count[i];
       }
       
       for(int i=n-1;i>=0;i--){
           int rem=((arr[i]/pos)%10);
           count[rem]--;
           store[count[rem]]=arr[i];
       }
       
       for(int i=0;i<n;i++){
           arr[i]=store[i];
           
       }
       count={0};
       
       
   }
    void radixSort(vector<int>& arr) {
        
        int mx=*max_element(begin(arr),end(arr));
        
        for(int i=1;mx/i>0;i*=10){
            countingSort(arr,arr.size(),i);
        }
        
        
        
    }
};
