//Time Complexity:O(V+E)
//Space Complexity:O(V)


class Solution {
  public:
    void DFS(int node,vector<vector<int>>&adj,vector<int>&visit,vector<int>&ans){
          visit[node]=1;
          ans.push_back(node);
          
          for(int i=0;i<adj[node].size();i++){
              if(visit[adj[node][i]]==0){
                  DFS(adj[node][i],adj,visit,ans);
              }
          }
        
    }
    vector<int> dfs(vector<vector<int>>& adj) {
        int n=adj.size();
        vector<int>ans;
        vector<int>visit(n,0);
        DFS(0,adj,visit,ans);
        
        return ans;
        
    }
};
