//Time Complexity: O(n)
//Auxiliary Space: O(n)

class Solution {
  public:
    bool isBalanced(string& s) {
        
        if(s.size()%2==1)return false;
    
       stack<char>st;
       for(int i=0;i<s.size();i++){
           if(!st.empty() and (s[i]==')' or s[i]=='}' or s[i]==']')){
                if(s[i]==')' and st.top()=='(')st.pop();
                else if (s[i]=='}' and st.top()=='{')st.pop();
                else if(s[i]==']' and st.top()=='[')st.pop();
                else return false;
                
           }
           else st.push(s[i]);
       }
       
       
       
       return (st.empty() ? true : false);
        
        
    }
};
