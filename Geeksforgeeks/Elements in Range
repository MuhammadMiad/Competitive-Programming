//Time Complexity:O(n)
//Space Complexity:O(1)

class Solution {
  public:
    bool checkElements(int start, int end, vector<int> &arr) {
        int co=0;
        for(int i=0;i<arr.size();i++){
            if(start<=arr[i] and end>=arr[i])co++;
        }
        
        if(co==end-start+1)return true;
        
        
        return false;
        
    }
};
