//Time Complexity: O(log n * log10 n)
//Auxiliary Space: O(1)

//Method-01:
class Solution {
  public:
    int  numberCount(int n, int k) {
        
       long long r=n,l=1;
       long long result=n+1;
       while(l<=r){
           long long  mid=l+(r-l)/2;
           
           long long check=mid;
           long long sum=0;
           
           while(check){
               sum+=check%10;
               check/=10;
           }
           if(mid-sum>=k){
               result=mid;
               r=mid-1;
           }
           else l=mid+1;
       }
       
       return (int)n-result+1;
        
    }
};

//Mehtod-02

class Solution {
  public:
    int numberCount(int n, int k) {
        if (k > n) return 0;

        long long l = max(1, k);
        long long r = min((long long)n, (long long)k + 200);
        long long first = (long long)n + 1;   

        while (l <= r) {
            long long mid = l + (r - l) / 2;

            long long t = mid, sum = 0;
            while (t) {
                sum += t % 10;
                t /= 10;
            }

            if (mid - sum >= k) {
                first = mid;
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }

        return (int)(n - first + 1);
    }
};

