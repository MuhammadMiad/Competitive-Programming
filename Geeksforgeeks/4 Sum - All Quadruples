//Time Complexity: O(n^3)
//Auxiliary Space: O(1)

class Solution {
  public:
    vector<vector<int>> fourSum(vector<int> &arr, int target) {
        
        vector<vector<int>>ans;
        int n=arr.size();
        sort(begin(arr),end(arr));
        
        for(int i=0;i<n-3;i++){
             if(i>0 and arr[i-1]==arr[i])continue;
            for(int j=i+1;j<n-2;j++){
                 if(j>i+1 and arr[j-1]==arr[j])continue;
                
                 int l=j+1,r=n-1;
                 while(l<r){
                    int sum=arr[l]+arr[r]+arr[i]+arr[j];
                    
                    if(sum==target){
                        ans.push_back({arr[i],arr[j],arr[l],arr[r]});
                        l++;r--;
                        while(l<r and arr[l]==arr[l-1])l++;
                        while(l<r and arr[r]==arr[r+1])r--;
                    }
                    else if(sum<target)l++;
                    else r--;
                 }
            }
        }
        
       return ans;
    }
};
