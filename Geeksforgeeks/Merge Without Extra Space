//TC:O(nlogn+mlogm)
//SC:O(1)

class Solution {
  public:
    void mergeArrays(vector<int>& a, vector<int>& b) {
        
         int n=a.size();
         int m=b.size();
         
         if(a[n-1]<=b[0]){
             return;
         }
         
         int l=n-1,r=0;
         while(l>=0 and r<m){
             if(a[l]>b[r]){
                 int val=a[l];
                 a[l]=b[r];
                 b[r]=val;
                 
             }
                 l--; r++;
         }
         
         sort(begin(a),end(a));
         sort(begin(b),end(b));
         
        
    }
};
