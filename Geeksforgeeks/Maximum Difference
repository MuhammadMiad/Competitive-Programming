//Time Complexity: O(n)
//Auxiliary Space: O(n)

class Solution {
  public:
    int findMaxDiff(vector<int> &arr) {
        
        int n=arr.size();
        stack<int>st;
        vector<int>temp1(n,0),temp2(n,0);
        
        for(int i=0;i<n;i++){
            while(!st.empty() and st.top()>=arr[i])st.pop();
            
            if(!st.empty())temp1[i]=st.top();
            
            st.push(arr[i]);
        }
        
        
         while(!st.empty())st.pop();
        
          for(int i=n-1;i>=0;i--){
            while(!st.empty() and st.top()>=arr[i])st.pop();
            
            if(!st.empty())temp2[i]=st.top();
            
            st.push(arr[i]);
        }
        
        int mx=0;
        for(int i=0;i<n;i++){
            mx=max(mx,abs(temp1[i]-temp2[i]));
        }
        
        
        return mx;
        
    }
};
