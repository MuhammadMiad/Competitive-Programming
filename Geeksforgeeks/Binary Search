//Time Complexity:O(log n)
//Space Complexity:O(1)

class Solution {
  public:
    int binarySearch(vector<int>& arr, int k) {
        int n=arr.size();
        
        int left=0,right=n-1;
        while(left<=right){
            
            int mid=left+(right-left)/2;
            if(arr[mid]==k)return mid;
            else if(arr[mid]>k)right=mid-1;
            else left=mid+1;
        }
        
        
        
        return -1;
        
    }
};
