//Time Complexity:O(logn)
//Space Complexity:O(1) 



class Solution {
  public:
    vector<int> find(vector<int>& arr, int x) {
        int n=arr.size();
        
        int i=0,j=n-1;
        int first=-1,last=-1;
        while(i<=j){
            int mid=i+(j-i)/2;
            
            if(arr[mid]==x){
                first=mid;
                j=mid-1;
            }
            else if(arr[mid]<x)i=mid+1;
            else j=mid-1;
        }
        
        i=0,j=n-1;
        while(i<=j){
            int mid=i+(j-i)/2;
            
            if(arr[mid]==x){
                last=mid;
                i=mid+1;
            }
            else if(arr[mid]>x)j=mid-1;
            else i=mid+1;
        }
        
        
        return{first,last};
        
    }
};
