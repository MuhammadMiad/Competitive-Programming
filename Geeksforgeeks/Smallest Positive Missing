//Time Complexity: O(n)
//Auxiliary Space: O(1)


class Solution {
  public:
    int missingNumber(vector<int> &arr) {
       
       int n=arr.size();
       
       for(int i=0;i<n;i++){
           
           while(arr[i]>=1 and arr[i]<=n  and arr[arr[i]-1]!=arr[i] ){
               swap(arr[arr[i]-1],arr[i]);
           }
       }
       
       
       for(int i=0;i<n;i++)if(arr[i]!=i+1)return i+1;
       
       return n+1;
        
    }
};
