//Time Complexity: O(n^2)
//Auxiliary Space: O(1)


class Solution {
  public:
    bool findTriplets(vector<int> &arr) {
        
         int n=arr.size();
         
         sort(begin(arr),end(arr));
         
         for(int i=n-1;i>=2;i--){
             int value=-arr[i];
             
             int l=0,r=i-1;
             while(l<r){
                 int sum=arr[l]+arr[r];
                 if(sum==value)return true;
                 else if(sum>value)r--;
                 else l++;
             }
         }
        return false;
    }
};
