//Time Complexity: O(n)
//Auxiliary Space: O(n)



class Solution {
  public:
    vector<int> prevSmaller(vector<int>& arr) {
        stack<int>st;
        vector<int>ans(arr.size(),-1);
        
        for(int i=0;i<arr.size();i++){
            while(!st.empty() and st.top()>=arr[i])st.pop();
            
            if(!st.empty())ans[i]=st.top();
            
            st.push(arr[i]);
        }
        
        
        return ans;
        
    }
};
