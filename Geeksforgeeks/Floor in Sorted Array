//Time Complexity:O(log n)
//Space Complexity:O(1)



class Solution {
  public:
    int findFloor(vector<int>& arr, int x) {
        
        int n=arr.size();
        int i=0,j=n-1;
        int target=-1;
        while(i<=j){
            int mid=i+(j-i)/2;
            
            if(mid+1<n and arr[mid]== x and x==arr[mid+1]){
                i=mid+1;
            }
            else if(arr[mid]==x)return mid;
            else if(arr[mid]<x){
                target=mid;
                i=mid+1;
            }
            else j=mid-1;
        }
        
        
        return target;
        
    }
};
