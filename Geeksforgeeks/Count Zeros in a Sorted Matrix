//Time Complexity:O(n)
//Space Complexity:O(1)


class Solution {
  public:
    int countZeros(vector<vector<int>>& mat){
        int n=mat.size();
        
        int i=n-1,j=0;
        int sum=0;
        while(i>=0 and j<n){
            if(mat[i][j]==1)i--;
            else if( j+1<n and mat[i][j+1]==1){
                sum+=j+1;
                i--;
            }
            else if(j+1<n and mat[i][j+1]==0){
                j++;
            }
            else if(j==n-1 and i==0){
                sum+=j+1;
                i--;
            }
            
        }
        
        return sum;
    }
};
