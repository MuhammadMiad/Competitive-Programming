//Time Complexity:O(n)
//Space Complexity:O(1)


class Solution {
  public:
    int fun(char ch){
        if(ch=='I')return 1;
        else if(ch=='V')return 5;
        else if(ch=='X')return 10;
        else if(ch=='L')return 50;
        else if(ch=='C')return 100;
        else if(ch=='D')return 500;
        else return 1000;
    }
    int romanToInteger(string &s) {
        
        int n=s.size();
        int sum=0;
        for(int i=0;i<n-1;i++){
            if(fun(s[i])>=fun(s[i+1])){
                sum+=fun(s[i]);
            }
            else{
                sum-=fun(s[i]);
                
            }
        }
        
        sum+=fun(s[n-1]);
        
        
        return sum;
        
    }
};
