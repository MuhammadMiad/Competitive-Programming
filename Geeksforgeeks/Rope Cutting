//Time Complexity: O(n log n)
//Auxiliary Space: O(1)

class Solution {
  public:
    vector<int> ropeCutting(vector<int>& arr) {
        int n=arr.size();
        
        sort(begin(arr),end(arr));
        vector<int>ans;
        
        for(int i=0;i<n-1;i++){
            if(arr[i]!=arr[i+1]){
               ans.push_back(n-i-1);
            }
            
        }
        
        return ans;
        
    }
};
