//Time Complexity:O(n^2)
//Space Complexity:O(1)


class Solution {
  public:
    void bubbleSort(vector<int>& arr) {
      
      int n=arr.size();
      for(int i=0;i<n-1;i++){
          int check=0;
          for(int j=0;j<n-i-1;j++){
              if(arr[j]>arr[j+1]){
                  swap(arr[j],arr[j+1]);
                  check=1;
              }
          }
          if(check==0)break;
      }
    }
};
