//Time Complexity:O(n)
//Space Complexity:O(n)

//Interviewbit ---->MAXSPPROD

int Solution::maxSpecialProduct(vector<int> &A) {
    int n=A.size();
    vector<int>pre(n,0),suf(n,0);
    stack<int>st;
    for(int i=0;i<n;i++){
        while(!st.empty() and A[st.top()]<=A[i])st.pop();
        
        if(!st.empty())pre[i]=st.top();
        st.push(i);
    }
    while(!st.empty())st.pop();
    
    for(int i=n-1;i>=0;i--){
        while(!st.empty() and A[st.top()]<=A[i])st.pop();
        
        if(!st.empty())suf[i]=st.top();
        st.push(i);
    }
    
    long long ans=0;
    for(int i=0;i<n;i++){
        ans=max(ans,(long long)pre[i]*suf[i]);
    }
       return ans%1000000007;
  
}
