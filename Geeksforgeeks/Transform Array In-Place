
//Time Complexity: O(n)
//Space Complexity: O(1)

class Solution {
  public:
    void arrange(vector<int>& arr) {
        
        int mx=*max_element(begin(arr),end(arr))+1;
        
        for(int i=0;i<arr.size();i++){
            arr[i]+=(arr[arr[i]]%mx)*mx;
        }
        
        for(int i=0;i<arr.size();i++){
            arr[i]/=mx;
        }
        
    }
};
