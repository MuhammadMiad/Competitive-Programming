//Time Complexity:O(n)
//Space Complexity:O(n)


class Solution {
  public:
    bool isRepeat(string &s) {
       int n=s.size();
       string str="";
       for(int i=1;i<=n/2;i++){
           str=s.substr(0,i);
           string ss=str;
           while(ss.size()<s.size()){
               ss+=str;
           }
           if(ss==s)return 1;
          
       }
        
        return 0;
    }
};
