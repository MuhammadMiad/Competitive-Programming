//Time Complexity:O(n+m)
//Space Complexity:O(1)


class Solution {
  public:
    int rowWithMax1s(vector<vector<int>> &arr) {
        int n=arr.size();
        int m=arr[0].size();
        
        int ans=-1;
        int j=m-1; 
        for(int i=0;i<n;i++){
            while(j>=0 and arr[i][j]==1){
                ans=i;
                j--;
            }
        }
        
        return ans;
        
    }
};
