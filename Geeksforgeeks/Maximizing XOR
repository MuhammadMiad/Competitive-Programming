//Time Complexity:O(1)
//Space Complexity:O(1)


//Method-01
#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
    int l,r;cin>>l>>r;
    int num_result=l^r;
    int num=32-__builtin_clz(num_result);

    cout<<(1<<num)-1<<endl;

return 0;
}


//Time Complexity:O((r-l)*32)
//Space Complexity:O(1)

//Method-02
#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
    ll l,r;cin>>l>>r;
    ll ans=0;
    for(int b=0;b<=31;b++){
            ll c0=0,c1=0;
        for(ll  i=l;i<=r;i++){
            if((i&(1<<b))==(1<<b))c1++;
        }
        c0=(r-l+1)-c1;
        if(c0  and c1)ans+=(1LL<<b);
    }

    cout<<ans<<endl;

return 0;
}

