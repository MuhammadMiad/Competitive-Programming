//Time complexity:O(n)
//Space Complexity:O(1)


int Solution::atoi(const string A) {
    int n=A.size();
    
    int i=0;
    //remove space
    while(i<n and A[i]==' ')i++;
    
    //check sign
    int sign=1;
    if(i<n and (A[i]=='+' || A[i]=='-')){
        if(A[i]=='-')sign=-1;
        i++;
    }
    
    //convert digit to number
    long long  result=0;
    while(i<n and isdigit(A[i])){
        result=result*10+(A[i]-'0');
        
        if(sign*result>=INT_MAX)return  INT_MAX;
        if(sign*result<=INT_MIN)return INT_MIN;
        
        i++;
        
    }
    
    
    return sign*result;
