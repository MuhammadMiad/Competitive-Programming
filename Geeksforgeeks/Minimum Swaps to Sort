//Time Complexity: O(n log n)
//Auxiliary Space: O(n)




class Solution {
  public:
    int minSwaps(vector<int>& arr) {
        
        int n=arr.size();
        map<int,int>mp;
        
        for(int i=0;i<n;i++)mp[arr[i]]=i;
        
        int cnt=0,index=0;
        for(auto it:mp){
          if(index!=it.second){
              mp[arr[index]]=it.second;
              swap(arr[index], arr[it.second]);
              cnt++;
          }
          index++;
        }
        
        
        return cnt;
        
    }
};
