//TC:O(n)
//SC:O(n)


class Solution {
public:
    int calPoints(vector<string>& operations) {
        stack<int>st;
        int n=operations.size();
        for(int i=0;i<n;i++){
           
          if(operations[i]=="C"){
                if(!st.empty()){
                    st.pop();
                }
            }
            else if(operations[i]=="+"){
                if(st.size()>=2){
                    int x=st.top();
                    st.pop();
                    int y=st.top();
                    st.push(x);
                    st.push(x+y);
                }else st.push(st.top());
            }
            else if(operations[i]=="D"){
                if(!st.empty()){
                    int x=st.top();
                    st.push(x*2);
                }
                
            }
            else{
                st.push(stoi(operations[i]));
            }
        }

        int sum=0;
        while(!st.empty()){
            sum+=st.top();
            st.pop();
        }


        return sum;
    }
};
