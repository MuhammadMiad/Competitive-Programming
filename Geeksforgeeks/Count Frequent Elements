//Time Complexity: O(n)
//Auxiliary Space: O(n)

class Solution {
  public:
    int countOccurence(vector<int>& arr, int k) {
        int n=arr.size();
        
        int check=n/k;
        unordered_map<int,int>mp;
        for(int i=0;i<n;i++)mp[arr[i]]++;
        
        
        
        int cnt=0;
        for(auto it:mp)if(it.second>check)cnt++;
        
        return cnt;
        
    }
};
