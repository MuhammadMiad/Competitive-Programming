//Time Complexity: O(n log n)
//Auxiliary Space: O(1)


class Solution {
  public:
    void sortIt(vector<int>& arr) {
        sort(rbegin(arr),rend(arr));
        int n=arr.size();
        int index=0,j=0;
        int flag=0;
        for(int i=0;i<n;i++){
           if(arr[i]%2){
               swap(arr[i],arr[j]);
               index=j;j++;
               flag=1;
           }
        }
        
         if(flag)sort(begin(arr)+index+1,end(arr));
         else sort(begin(arr),end(arr));
         
        
    }
};
