//Time Complexity: O(log n)
//Auxiliary Space: O(1)




class Solution {
  public:
    int findMaximum(vector<int> &arr) {
        
        int n=arr.size();
        
        int i=0,j=n-1;
        while(i<j){
            int mid=i+(j-i)/2;
            
            if(mid+1<n and arr[mid]<arr[mid+1])i=mid+1;
            else if(mid-1>=0 and arr[mid]<arr[mid-1])j=mid-1;
            else return arr[mid];
        }
        
        return arr[j];
        
    }
};
