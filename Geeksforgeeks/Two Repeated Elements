//Time Complexity: O(n)
//Auxiliary Space: O(1)


class Solution {
  public:
    vector<int> twoRepeated(vector<int>& arr) {
        int n=arr.size();
        
        vector<int>result;
        
        for(int i=0;i<n;i++){
            int v=abs(arr[i]);
            
            if(arr[v-1]<0){
                result.push_back(v);
            }
            else arr[v-1]=-arr[v-1];
        }
        
        for (int &x : arr) x = abs(x);
        return result;
        
    }
};
