//Time Complexity: O(n log n)
//Auxiliary Space: O(n)



class Solution {
  public:
    void relativeSort(vector<int>& a1, vector<int>& a2) {
        
        map<int,int>mp;
        for(int i=0;i<a1.size();i++)mp[a1[i]]++;
        
        int j=0;
        for(int i=0;i<a2.size();i++){
            int v=a2[i];
            
            while(mp[v]){
                a1[j++]=v;
                mp[v]--;
            }
        }
        
        for(auto it:mp){
           while(it.second){
                a1[j++]=it.first;
                it.second--;
            } 
        }
        
    }
};
