//Time Complexity:O(n)
//Space Complexity:O(1)

class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n=nums.size(); 
       int first=-1;
       for(int i=n-1;i>0;i--){
           if(nums[i-1]<nums[i]){
               first=i-1;
               break;
           }
       }
       
       int swap_index=first;
       if(first!=-1){
           for(int j=n-1;j>=first+1;j--){
               if(nums[first]<nums[j]){
                   swap_index=j;
                   break;
                }
           }
           swap(nums[first],nums[swap_index]);
       }
       reverse(nums.begin()+first+1,nums.end());
    }
};
