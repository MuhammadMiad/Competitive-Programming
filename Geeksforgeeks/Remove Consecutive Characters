//Time Complexity:O(n)
//Space Complexixity:O(1)


string Solution::solve(string s, int B) {
    string str;
    int cnt=1;
    for(int i=0;i<s.size()-1;i++){
        if(s[i]==s[i+1])cnt++;
        else{
            if(cnt!=B)str+=string(cnt,s[i]);
            
            cnt=1;
        }
    }
    if(cnt!=B)str+=string(cnt,s[s.size()-1]);
    
    return str;
    
}
