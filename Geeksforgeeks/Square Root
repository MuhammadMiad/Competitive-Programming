//Time Complexity: O(log n)
//Auxiliary Space: O(1)



class Solution {
  public:
    int floorSqrt(int n) {
        
        int res=0;
        int  l=1,r=n;
        while(l<=r){
            int mid=l+(r-l)/2;
            
            if(mid==n/mid){
                res=mid;
                break;
            }
            else if(mid>n/mid)r=mid-1;
            else {
                res=mid;
                l=mid+1;
            }
        }
        
        
        
        
        return res;
        
    }
};
