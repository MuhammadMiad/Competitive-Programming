//Time Complexity: O(n)
//Auxiliary Space: O(n)

class Solution {
  public:
    void deleteMid(stack<int>& st) {
        vector<int>arr;
        int n=st.size(),x=n/2;
        while(!st.empty()){
            
            if(x!=0)arr.push_back(st.top());
            st.pop();
            x--;
            
        }
        
        for(int i=arr.size()-1;i>=0;i--)st.push(arr[i]);
        
    }
};
