//Time Complexity: O(n log n)
//Auxiliary Space: O(1)



class Solution {
  public:
    int minIncrements(vector<int>& arr) {
        int n=arr.size();
        
        sort(begin(arr),end(arr));
        
        int cnt=0;
        for(int i=0;i<n-1;i++){
            if(arr[i]>=arr[i+1]){
                int v=arr[i]-arr[i+1];
                cnt+=(arr[i]-arr[i+1])+1;
                arr[i+1]+=(arr[i]-arr[i+1])+1;
            }
        }
        
        return cnt;
        
    }
};
