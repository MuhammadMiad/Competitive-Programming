//Time Complexity: O((log n)^2)
//Auxiliary Space: O(1)


class Solution {
  public:
    int findNum(int n) {
      
        int l=1, r=5*n;
        
        int result=r;
        while(l<=r){
           
           int mid=l+(r-l)/2;
           
          int cnt=0;
          
          for(int i=5;i<=mid;i*=5){
              cnt+=mid/i;
          }
          
          
          if(cnt>=n){
              result=mid;
              r=mid-1;
          }
          else l=mid+1;
            
            
        }
        
        
        return result;
       
    }
};
