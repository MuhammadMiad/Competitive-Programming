//Time Complexity: O(log(n * m))
//Auxiliary Space: O(1)

//Method-01

class Solution {
  public:
    bool searchMatrix(vector<vector<int>> &mat, int x) {
        
       int n=mat.size();
       int m=mat[0].size();
       
       int l=0,r=n*m-1;
       
       while(l<=r){
           int mid=l+(r-l)/2;
           
           int ind_row=mid/m;
           int ind_col=mid%m;
           
           if(mat[ind_row][ind_col]==x)return true;
           else if(mat[ind_row][ind_col]<x)l=mid+1;
           else r=mid-1;
       }
       
       
       return false;
        
    }
};

//Method-02

//Time Complexity: O(n * m)
//Auxiliary Space: O(1)



class Solution {
  public:
    // Function to search a given number in row-column sorted matrix.
    bool search(vector<vector<int> > &matrix, int n, int m, int x) {
        if(m==0 && n==0)return false;
        int left=0;
        int right=m-1;
        while(left<n&&right>=0){
            if(matrix[left][right]==x)return true;
            else if(matrix[left][right]>x)left++;
            else right--;
        }
        return false;
    }
};

