//Time Complexity:O(n)
//Space Complexity:O(1)



class Solution {
  public:
    vector<int> nextPalindrome(vector<int>& arr) {
            int n = arr.size();
               bool all9=true;
               for(auto x:arr){
                   if(x!=9){
                   all9=false;
                   break;
                  }
               }
               
               if(all9){
                   vector<int>ans(n+1,0);
                   ans[0]=ans[n]=1;
                   return ans;
               }
               
               
               int i=n/2-1;
               int j=(n%2)?n/2+1:n/2;
               
               while(i>=0 and arr[i]==arr[j]){i--;j++;}
               
               bool increase=(i<0 || arr[i]<arr[j]);
               
               while(i>=0)arr[j++]=arr[i--];
               
               
               if(increase){
                   int carry=1;
                   i=n/2-1;
                   if(n%2){
                       int mid=n/2;
                       arr[mid]+=carry;
                       carry=arr[mid]/10;
                       arr[mid]%=10;
                       j=mid+1;
                   }
                   else j=n/2;
                   
                   while(i>=0){
                       arr[i]+=carry;
                       carry=arr[i]/10;
                       arr[i]%=10;
                       arr[j++]=arr[i--];
                   }
               }
               
               
               return arr;
               
              
                   
        }
};
