//Max Circular Subarray Sum   Using Kadane Algorithm
//Time Complexity:O(n)
//Space Complexity:O(1)


class Solution {
  public:
    int maxCircularSum(vector<int> &arr) {
              int n = arr.size();

              long long total = 0;
              long long maxSum = LLONG_MIN;
              long long minSum = LLONG_MAX;
          //Normal total Sum;
              for (int i = 0; i < n; i++) {
                  total += arr[i];
              }
              
               long long sum=0;
               
             //Kadane maxSubarray Sum
                  for(int i=0;i<n;i++){
                      sum+=arr[i];
                      maxSum=max(maxSum,sum);
                      if(sum<0)sum=0;
                  }

                  sum=0;
                  
            //Kadane MinSubaray Sum
                  for(int i=0;i<n;i++){
                      sum+=arr[i];
                      minSum=min(minSum,sum);
                      if(sum>0)sum=0;
                  }

              if (maxSum < 0) return maxSum;          
              return max(maxSum, total - minSum);
        
    }
};
