//Time Complexity:O(n)
//Space Complexity:O(1)

class Solution {
  public:
    int longestUniqueSubstr(string &s) {
       int n=s.size();
       
       vector<int>count(256,0);
       int i=0,j=0;
       int len=1;
       while(j<n){
           while(count[s[j]]){
               count[s[i++]]--;
           }
           
           count[s[j]]++;
           
           len=max(len,j-i+1);
           j++;
           
       }
       
       return len;
        
    }
};
