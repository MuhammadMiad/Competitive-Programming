//Time Complexity: O(n)
//Auxiliary Space: O(1)


class Solution {
  public:
    bool pairWiseConsecutive(stack<int>& st) {
        
        
        if(st.size()%2==1)st.pop();
        
        while(!st.empty()){
            int x=st.top();
            st.pop();
            int y=st.top();
            st.pop();
            
            if(abs(x-y)!=1)return false;
            
            
        }
        
        
        
        return true;
        
    }
};
