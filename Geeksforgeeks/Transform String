

//Time Complexity:O(n)
//Space Complexity:O(1)



class Solution {
  public:
    int transform(string &s1, string &s2) {
        if(s1==s2)return 0;
        vector<int>str1(256,0);
        vector<int>str2(256,0);
        
        for(int i=0;i<s1.size();i++)str1[s1[i]]++;
        for(int i=0;i<s2.size();i++)str2[s2[i]]++;
        
        int flag=0;
        for(int i=0;i<256;i++)if(str1[i]!=str2[i]){flag=1;break;}
        if(flag)return -1;
        
        
         int cnt=0,i=s2.size()-1,j=s1.size()-1;
         while(j>=0){
             
             while(i>=0  and j>=0 and s1[j]==s2[i]){i--;j--;}
             while(j>=0 and s1[j]!=s2[i]){j--;cnt++;}
         }
        
        
        return cnt;
    }
};
