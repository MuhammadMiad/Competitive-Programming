//Subarrays Product Less than K Using 
//Time Complexity:O(n)
//Space Complexity:O(1)


class Solution {
  public:
    int countSubarray(vector<int>& arr, int k) {
        int n=arr.size();
        int product=1;
        int ans=0,l=0;
        for(int i=0;i<n;i++){
            product*=arr[i];
            while(product>=k and l<=i){
                product/=arr[l];
                l++;
            }
            
            ans+=i-l+1;
        }
        
        
        
        return ans;
        
    }
};
