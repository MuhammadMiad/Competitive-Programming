//Time Complexity:O(n^2)
//Space Complexity:O(1)



#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
void solve(){
     int n;cin>>n;
     vector<int>arr(n);
     for(int i=0;i<n;i++){
        cin>>arr[i];
     }

     int mx=0;
     for(int i=0;i<n;i++){
            int cnt=0;
        for(int j=0;j<n;j++){
            if(arr[j]%arr[i]==0)cnt++;
        }

      mx=max(mx,cnt);
     }

     cout<<n-mx<<'\n';

}
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
    int t;cin>>t;while(t--)solve();

return 0;
}
