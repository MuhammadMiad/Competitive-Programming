//Time complexity:O(n)
//Space Complexity:O(1)

#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
void solve(){
         int n;cin>>n;
         vector<int>arr(n);
         for(int i=0;i<n;i++){
            cin>>arr[i];
         }

         int mx=~0;
         for(int i=0;i<n;i++){
            if(arr[i]!=i) mx&=arr[i];
         }

         cout<<mx<<endl;

}
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
   int t;cin>>t;while(t--)solve();
return 0;
}
