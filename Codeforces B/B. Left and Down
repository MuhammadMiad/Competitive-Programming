//TC:O(1)
//SC:O(1)

#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;cin>>t;
    while(t--){
    ll a,b,k;
    cin>>a>>b>>k;

    ll d=__gcd(a,b);

    ll dx=a/d;
    ll dy=b/d;

    if(dx<=k and dy<=k){
        cout<<1<<'\n';
    }
    else cout<<2<<'\n';

    }
    return 0;
}
