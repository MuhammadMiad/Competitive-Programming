//Time Complexity:O(n)
//Space Complexity:O(1)

#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
    int n;cin>>n;
    vector<int >arr(n);
    ll S=0;
    for(int i=0;i<n;i++){
        cin>>arr[i];
        S^=arr[i];
    }

    for(int i=0;i<n;i++){
        cout<<(S^arr[i])<<" ";
    }
    cout<<'\n';


return 0;
}
