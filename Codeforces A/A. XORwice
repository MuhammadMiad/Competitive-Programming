//Time Complexity:O(1)
//Space Complexity:O(1)



#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
void solve(){
              ll a,b;cin>>a>>b;
              ll ans=0;
              for(int x=0;x<32;x++){
                   int c1=0;
                   if((a&(1<<x))==(1<<x))c1++;
                   if((b&(1<<x))==(1<<x))c1++;

                   if(c1==2)ans+=(1<<x);

              }

              if(ans)cout<<(ans^a)+(ans^b)<<endl;
              else cout<<a+b<<endl;


}
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
   int t;cin>>t;while(t--)solve();
return 0;
}
