//Time Complexity:O(n)
//Space Complexity:O(n)


#include <bits/stdc++.h>
using namespace std;
typedef unsigned long long ull;
void solve(){
     int n,m;cin>>n>>m;
     string s1,s2;cin>>s1>>s2;

     if(n-3!=m){
        cout<<"NO"<<'\n';
        return ;
     }
     map<char,int>mp;
     for(int i=0;i<n;i++){
        mp[s1[i]]++;
     }

     if(mp['s'] and mp['i'] and mp['x']){
          for(int i=0;i<m;i++){
              mp[s2[i]]--;
         }
     int s=0,i=0,x=0;
     int flag=1;
     for(auto it:mp){
        if(it.first=='s'  and it.second==1)s=1;
        else if(it.first=='i' and it.second==1)i=1;
        else if(it.first=='x' and it.second==1)x=1;
        else if( it.second!=0)flag=0;
     }
     if(s && i && x and flag){
        cout<<"YES"<<'\n';
     }
     else cout<<"NO"<<'\n';
     }
     else{
        cout<<"NO"<<'\n';
     }

}
int main() {
    ios_base::sync_with_stdio(false); cin.tie(nullptr);
    int  t;cin>>t;while(t--)solve();
    return 0;
}
