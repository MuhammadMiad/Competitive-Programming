//Time Complexity: O(n)
//Space Complexity O(1);

#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
void solve(){
              ll n,k;
              cin>>n>>k;
              vector<ll>arr(n+1);
              for(int i=1;i<=n;i++)cin>>arr[i];

              ll sum=0;
              if(n-k+1>=k){
                   for(int i=k;i<=n-k+1;i++){
                     sum+=arr[i];
                   }

                   for(int i=1;i<k;i++){
                      sum+=max(arr[k-i],arr[n-k+1+i]);
                   }
              }
              else{
                    for(int i=1;i<=n-k+1;i++){
                        sum+=max(arr[n-k+2-i],arr[k-1+i]);
                    }
              }

              cout<<sum<<endl;


}
int main(){
int t;cin>>t;while(t--)solve();


return 0;
}
