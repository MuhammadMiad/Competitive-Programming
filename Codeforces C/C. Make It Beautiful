//Time Complexity:O(T*n*62)
//Space complexity:O(1)

#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
void solve(){
      ll n,k;cin>>n>>k;
      vector<ll>arr(n);
      for(int i=0;i<n;i++)cin>>arr[i];

      ll ans=0;
      for(int i=0;i<n;i++){
        ans+=__builtin_popcountll(arr[i]);
      }

      //cout<<ans<<endl;

      for(int b=0;b<61;b++){
        ll c0=0;
        for(int i=0;i<n;i++){
            if((arr[i]&(1LL<<b))==0)c0++;
        }
        if(c0*(1LL<<b)<=k){
            ans+=c0;
            k-=c0*(1LL<<b);
        }
        else{
            ans+=k/(1LL<<b);
            break;
        }
      }

cout<<ans<<endl;
}
int main(){
    ios_base::sync_with_stdio(false);cin.tie(nullptr);
   int t;cin>>t;while(t--)solve();
return 0;
}
