//Time Complexity:O(n)
//Space Complexity:O(n)


#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
void solve(){
    int n;cin>>n;
    vector<int>arr(n);
    ll sum=0;
    for(int i=0;i<n;i++){
        int x;
        cin>>x;
        arr[i]=x;
        sum+=x;
    }

    int flag=false;
    for(int i=1;i<n-1;i++)if(arr[i]>=2)flag=true;

     if(flag) cout<<sum-1<<'\n';
     else if(arr[0]>=2 || arr[n-1]>=2)cout<<sum-(n-1)<<'\n';
     else cout<<-1<<'\n';


}
int main() {
    ios_base::sync_with_stdio(false); cin.tie(nullptr);
    int  t;cin>>t;while(t--)solve();
    return 0;
}
