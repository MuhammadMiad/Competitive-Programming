//TC:O(n)
//SC:(1)


#include<bits/stdc++.h>
using namespace std;
typedef long long int ll;
ll numberOfDivisors(ll x)
{
    ll ans=1;
    for(ll i=2; i*i<=x; i++)
    {
        ll cnt=0;
        while(x%i==0)
        {
            cnt++;
            x/=i;
        }
        ans*=(cnt+1);
    }

    if(x>1)ans*=2;

    return ans;
}
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    ll n;
    cin>>n;
    vector<ll>arr(n);
    for(auto &c:arr)cin>>c;

    ll gcd=0;
    for(int i=0; i<n; i++)
    {
        gcd=__gcd(gcd,arr[i]);
    }


    cout<<numberOfDivisors(gcd)<<endl;


    return 0;
}
