//Time Complexity:O(nlogn)
//Space Complexity:O(n)




#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
void solve(){
 int n;cin>>n;
 vector<int>arr(n);
 for(int i=0;i<n;i++)cin>>arr[i];

 sort(begin(arr),end(arr));
 int mid=arr[n/2];
 ll op=arr[n-1]-arr[0];
 ll cost=0;
 for(int i=0;i<n;i++){
    cost+=abs(mid-arr[i]);
 }

 cout<<cost<<" "<<op<<endl;

}
int main() {
    ios_base::sync_with_stdio(false); cin.tie(nullptr);
    int  t;cin>>t;while(t--)solve();
    return 0;
}
